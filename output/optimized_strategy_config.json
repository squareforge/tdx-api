{
  "name": "优化版-趋势回踩突破策略 V2",
  "description": "基于历史数据分析优化的保守版策略，增加涨幅上限过滤和风险控制",
  "version": "2.0",
  "changes": [
    "增加20日涨幅上限45%过滤，避免追高",
    "增加回撤深度要求8-20%，确保有调整空间",
    "增加市场状态过滤，避免逆市操作",
    "调整风险因子为稳定性评分",
    "优化买入价格区间计算"
  ],

  "config": {
    "universe": {
      "include": [
        {"pool_id": "market-all-a"}
      ]
    },
    "scan_limit": 300,
    "period": "day",
    "right": 1,
    "calc_count": 260,
    "batch_size": 50,
    "continue_on_error": true,

    "filters": [
      {
        "id": "market_not_weak",
        "factor": "market_momentum",
        "weight": 0,
        "params": {
          "days": 20,
          "min": -3,
          "max": 100
        },
        "comment": "上证指数20日跌幅不超过3%，避免在弱市选股"
      },
      {
        "id": "moderate_gain_20d",
        "factor": "gain_days",
        "weight": 0,
        "params": {
          "days": 20,
          "min": 15,
          "max": 45
        },
        "comment": "20日涨幅15-45%，有动能但不过热"
      },
      {
        "id": "pullback_deep_enough",
        "factor": "drawdown_from_high",
        "weight": 0,
        "params": {
          "days": 60,
          "min": 8,
          "max": 20
        },
        "comment": "距60日高点回撤8-20%，避免追顶部和弱势股"
      },
      {
        "id": "ma_bullish",
        "factor": "ma_trend",
        "weight": 0,
        "params": {
          "short": 5,
          "mid": 10,
          "long": 20
        },
        "comment": "均线多头排列，趋势确认"
      },
      {
        "id": "price_range",
        "factor": "price_range",
        "weight": 0,
        "params": {
          "min": 10,
          "max": 100
        },
        "comment": "价格10-100元，排除低价和高价股"
      },
      {
        "id": "min_liquidity",
        "factor": "min_amount",
        "weight": 0,
        "params": {
          "value": 300000000
        },
        "comment": "日成交额至少3亿，保证流动性"
      },
      {
        "id": "max_amplitude",
        "factor": "max_amplitude",
        "weight": 0,
        "params": {
          "days": 5,
          "max": 8
        },
        "comment": "5日平均振幅不超过8%，避免妖股"
      }
    ],

    "scores": [
      {
        "id": "trend_quality",
        "factor": "ma_slope",
        "weight": 20,
        "params": {
          "period": 20,
          "lookback": 5,
          "min": 2,
          "max": 15
        },
        "comment": "MA20斜率2-15%，上升趋势稳定"
      },
      {
        "id": "pullback_position",
        "factor": "drawdown_from_high",
        "weight": 15,
        "params": {
          "days": 60,
          "min": 8,
          "max": 20,
          "optimal_min": 10,
          "optimal_max": 15
        },
        "comment": "最优回撤10-15%，有反弹空间"
      },
      {
        "id": "volume_confirmation",
        "factor": "volume_up",
        "weight": 20,
        "params": {
          "days": 5,
          "ratio": 1.3
        },
        "comment": "当日放量1.3倍以上，有资金参与"
      },
      {
        "id": "close_strength",
        "factor": "close_strength",
        "weight": 15,
        "params": {
          "min_position": 0.7,
          "max_upper_shadow": 3
        },
        "comment": "收盘位置强，上影线小于3%"
      },
      {
        "id": "gain_momentum",
        "factor": "gain_days",
        "weight": 15,
        "params": {
          "days": 20,
          "min": 15,
          "max": 45,
          "optimal_min": 25,
          "optimal_max": 40
        },
        "comment": "20日涨幅25-40%为最佳区间"
      },
      {
        "id": "stability",
        "factor": "max_amplitude",
        "weight": 15,
        "params": {
          "days": 5,
          "max": 7
        },
        "comment": "振幅越小越稳定"
      }
    ],

    "pass": {
      "min_score": 55,
      "top_n": 5
    },

    "execution": {
      "min_open_gap": -0.025,
      "max_open_gap": 0.015,
      "comment": "次日开盘在[-2.5%, +1.5%]区间内才执行买入"
    }
  },

  "risk_management": {
    "stop_loss": -0.07,
    "take_profit": 0.10,
    "max_hold_days": 5,
    "position_size": 0.2,
    "max_positions": 3,
    "comments": [
      "单笔止损-7%",
      "止盈目标+10%",
      "最长持有5天（T+6）",
      "单只仓位20%",
      "最多持有3只"
    ]
  },

  "expected_performance": {
    "win_rate": "50-55%",
    "avg_profit": "2-4%",
    "avg_loss": "-5%",
    "profit_factor": "1.5-2.0",
    "max_consecutive_loss": "<8",
    "comment": "保守估计，需要3个月验证"
  }
}
